<Window x:Class="BookClubApp.Controls.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение заказа" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WhiteBrush}" FontFamily="Segoe UI" Foreground="{StaticResource TextMainBrush}" ShowInTaskbar="False" UseLayoutRounding="True">
    <Border Padding="28" Background="{StaticResource WhiteBrush}"><StackPanel>
        <TextBlock Text="Оформление заказа" Style="{StaticResource SectionTitleStyle}" FontSize="25"/>
        <Border Background="{StaticResource BackgroundListBrush}" CornerRadius="8" Padding="20" Margin="0 22 0 0"><StackPanel>
            <TextBlock Text="Сумма заказа" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock x:Name="txtAmount" FontWeight="Bold" FontSize="28" Margin="0 8 0 20"/>
            <TextBlock Text="Оплата наличными" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Text="Оплатите заказ при получении в пункте выдачи." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 8 0 0"/>
        </StackPanel></Border>
        <TextBlock Text="Пункт выдачи №1" FontWeight="SemiBold" Margin="0 20 0 6"/>
        <TextBlock Text="г. Таганрог, ул. Чехова, 336" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="txtMessage" TextWrapping="Wrap" Margin="0 16 0 0" Foreground="{StaticResource ErrorBrush}"/>
        <Grid Margin="0 24 0 0"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="btnClose" Content="Назад" Height="44" Style="{StaticResource SecondaryButtonStyle}" Click="btnClose_Click"/>
            <Button x:Name="btnPay" Grid.Column="2" Content="Оформить заказ" Height="44" Style="{StaticResource PrimaryButtonStyle}" Click="btnPay_Click"/>
        </Grid>
    </StackPanel></Border>
</Window>