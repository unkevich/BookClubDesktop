<UserControl x:Class="BookClubApp.Controls.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded" FontFamily="Segoe UI" FontSize="13" Language="ru-RU"
             Foreground="{StaticResource TextMainBrush}" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="messagePanel" Visibility="Collapsed" Padding="12" CornerRadius="6" Background="{StaticResource BackgroundInfoBrush}" Margin="0 0 0 12"><TextBlock x:Name="txtBlockMessage" TextWrapping="Wrap"/></Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="editorColumn" Width="0"/></Grid.ColumnDefinitions>
            <!-- #region Lists and filters -->
            <Grid x:Name="listPanel" Margin="0 0 12 0" Background="{StaticResource WhiteBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20 8 20 16">
                    <ListBox x:Name="listTabs" SelectionChanged="listTabs_SelectionChanged" BorderThickness="0" Background="Transparent" FontSize="12">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12 12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="tabBorder" BorderThickness="0 0 0 2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource MainBrush}"/><Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource MainBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" Margin="20 0 12 12">
                    <Grid x:Name="searchContainer" Width="215" Height="40" Margin="0 0 8 8">
                        <TextBox x:Name="txtBoxLocalSearch" Style="{StaticResource EditorTextBoxStyle}" Padding="34 0 8 0" TextChanged="Filters_Changed" ToolTip="Поиск по названию, номеру или телефону" AutomationProperties.Name="Поиск в разделе"/>
                        <Path Data="{StaticResource SearchIcon}" Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" HorizontalAlignment="Left" Margin="11 0 0 0" IsHitTestVisible="False"/>
                        <TextBlock Text="Поиск в разделе..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="35 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtBoxLocalSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                    <ComboBox x:Name="comboCategoryFilter" Width="120" DisplayMemberPath="Name" Margin="0 0 8 8" SelectionChanged="Filters_Changed" ToolTip="Категория"/>
                    <ComboBox x:Name="comboStockFilter" Width="120" Margin="0 0 8 8" SelectionChanged="Filters_Changed" ToolTip="Наличие"/>
                    <ComboBox x:Name="comboPriceFilter" Width="112" Margin="0 0 8 8" SelectionChanged="Filters_Changed" ToolTip="Цена"/>
                    <ComboBox x:Name="comboStatusFilter" Width="155" Margin="0 0 8 8" SelectionChanged="Filters_Changed" ToolTip="Статус заказа"/>
                    <DatePicker x:Name="dateFilterFrom" Tag="Дата с" Width="125" Height="40" Margin="0 0 8 8" SelectedDateChanged="Filters_Changed" ToolTip="Заказы с даты"/>
                    <DatePicker x:Name="dateFilterTo" Tag="Дата по" Width="125" Height="40" Margin="0 0 8 8" SelectedDateChanged="Filters_Changed" ToolTip="Заказы по дату"/>
                    <ComboBox x:Name="comboSort" Width="160" Margin="0 0 8 8" SelectionChanged="Filters_Changed" ToolTip="Сортировка"/>
                    <Button Content="Сбросить" Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0 0 0 8" Click="btnReset_Click"/>
                    <StackPanel x:Name="productViewButtons" Orientation="Horizontal" Margin="8 0 0 8"><Button Content="▦" FontSize="20" Width="38" Height="40" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="btnCards_Click" ToolTip="Карточки"/><Button Content="☰" FontSize="17" Width="38" Height="40" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="btnTable_Click" ToolTip="Таблица"/></StackPanel>
                </WrapPanel>
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="12" Margin="20 0 20 0">
                    <Grid>
                        <ScrollViewer x:Name="productScroll" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="listProducts" ItemTemplate="{StaticResource ManagedProductTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
                        <DataGrid x:Name="gridProducts" Style="{StaticResource DashboardGridStyle}" PreviewMouseLeftButtonUp="gridRow_Click" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="130"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100"/>
                                <DataGridTextColumn Header="Остаток" Binding="{Binding BookCount}" Width="80"/>
                                <DataGridTemplateColumn Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource MoreButtonStyle}" Click="btnRowMenu_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="gridOrders" Style="{StaticResource DashboardGridStyle}" PreviewMouseLeftButtonUp="gridRow_Click" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№ заказа" Binding="{Binding Number}" Width="78"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="125"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding DisplayPhone}" Width="160"/>
                                <DataGridTextColumn Header="Товаров" Binding="{Binding ItemCount}" Width="70"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="105"/>
                                <DataGridTemplateColumn Header="Статус" CellTemplate="{StaticResource OrderStatusTemplate}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Оплата" Binding="{Binding Payment}" Width="180" MinWidth="180"/>
                                <DataGridTemplateColumn Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource MoreButtonStyle}" Click="btnRowMenu_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="gridClients" Style="{StaticResource DashboardGridStyle}" PreviewMouseLeftButtonUp="gridRow_Click" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                <DataGridTextColumn Header="Номер телефона" Binding="{Binding DisplayPhone}" Width="*" MinWidth="170"/>
                                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding Created_at, StringFormat=dd.MM.yyyy}" Width="150"/>
                                <DataGridTextColumn Header="Заказов" Binding="{Binding OrderCount}" Width="85"/>
                                <DataGridTemplateColumn Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource MoreButtonStyle}" Click="btnRowMenu_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="txtBlockEmpty" Text="Ничего не найдено" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="20 16 20 20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <Button Content="‹" FontSize="20" Width="35" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Height="36" Click="btnPrevious_Click"/>
                    <TextBlock x:Name="txtBlockPage" Grid.Column="1" Margin="12 0" VerticalAlignment="Center"/>
                    <Button Content="›" FontSize="20" Grid.Column="2" Width="35" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Height="36" Click="btnNext_Click"/>
                    <TextBlock Grid.Column="4" Text="Показывать по:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8 0" FontSize="11"/>
                    <ComboBox x:Name="comboPageSize" Grid.Column="5" Height="36" SelectionChanged="PageSize_Changed"/>
                </Grid>
            </Grid>
            <!-- #endregion -->
            <!-- #region Side editor -->
            <Border x:Name="editorPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0 0 0 12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock x:Name="txtBlockEditorTitle" Style="{StaticResource SectionTitleStyle}" FontSize="18" TextWrapping="Wrap"/><Button Grid.Column="1" Content="×" Style="{StaticResource LinkButtonStyle}" FontSize="22" Padding="0" Click="btnCancel_Click" ToolTip="Закрыть панель"/></Grid>
                    <TextBlock x:Name="txtBlockEditorError" Grid.Row="1" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0 0 0 8" Visibility="Collapsed"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0 0 8 10">
                            <StackPanel x:Name="productEditor" Visibility="Collapsed">
                                <Grid Height="90" Margin="0 0 0 10"><Border Background="{StaticResource BackgroundListBrush}" CornerRadius="6"/><Path Data="{StaticResource ProductIcon}" Width="34" Height="40" Stretch="Uniform" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/><Image x:Name="imagePreview" Stretch="Uniform"/></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Button Content="Загрузить обложку" Style="{StaticResource SecondaryButtonStyle}" Height="34" Click="btnImage_Click"/><Button Grid.Column="1" Content="Убрать" Style="{StaticResource LinkButtonStyle}" Click="btnRemoveImage_Click"/></Grid>
                                <TextBlock Text="Название" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxProductName" MaxLength="128" Style="{StaticResource EditorTextBoxStyle}"/>
                                <TextBlock Text="Автор / производитель" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxAuthor" MaxLength="128" Style="{StaticResource EditorTextBoxStyle}"/>
                                <TextBlock Text="Категория" Style="{StaticResource EditorLabelStyle}"/><ComboBox x:Name="comboProductCategory" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <TextBlock Text="Или новая категория" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxNewCategory" MaxLength="128" Style="{StaticResource EditorTextBoxStyle}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Цена, ₽" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxPrice" Style="{StaticResource EditorTextBoxStyle}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Старая цена, ₽" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxOldPrice" Style="{StaticResource EditorTextBoxStyle}"/></StackPanel>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="На складе" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxStock" MaxLength="10" Style="{StaticResource EditorTextBoxStyle}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Мин. остаток" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxMinStock" MaxLength="10" Style="{StaticResource EditorTextBoxStyle}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Описание" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxDescription" Height="110" Padding="10 8" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Style="{StaticResource EditorTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="clientEditor" Visibility="Collapsed">
                                <TextBlock Text="Номер телефона" Style="{StaticResource EditorLabelStyle}"/>
                                <Grid><TextBox x:Name="txtBoxClientPhone" Style="{StaticResource PhoneTextBoxStyle}"/><TextBlock Text="+7" Margin="39 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
                                <TextBlock x:Name="txtBlockPasswordLabel" Text="Пароль" Style="{StaticResource EditorLabelStyle}"/><PasswordBox x:Name="pwdBoxClientPassword" Style="{StaticResource AuthPasswordBoxStyle}" Padding="10 0"/>
                                <TextBlock Text="При редактировании оставьте пустым, чтобы сохранить пароль." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 7 0 0"/>
                                <TextBlock Text="Дата регистрации" Style="{StaticResource EditorLabelStyle}"/><DatePicker x:Name="dateClientCreated" Height="38"/>
                                <Border Background="{StaticResource BackgroundListBrush}" CornerRadius="6" Padding="12" Margin="0 18 0 0"><TextBlock Text="Роль: Клиент" Foreground="{StaticResource TextSecondaryBrush}"/></Border>
                            </StackPanel>
                            <StackPanel x:Name="orderEditor" Visibility="Collapsed">
                                <TextBlock Text="Клиент" Style="{StaticResource EditorLabelStyle}"/><ComboBox x:Name="comboOrderClient" DisplayMemberPath="DisplayPhone" SelectedValuePath="Id"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Дата" Style="{StaticResource EditorLabelStyle}"/><DatePicker x:Name="dateOrder" Height="40"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Время" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxOrderTime" MaxLength="5" Style="{StaticResource EditorTextBoxStyle}"/></StackPanel></Grid>
                                <TextBlock Text="Статус" Style="{StaticResource EditorLabelStyle}"/><ComboBox x:Name="comboOrderStatus"/>
                                <TextBlock Text="Способ оплаты" Style="{StaticResource EditorLabelStyle}"/><ComboBox x:Name="comboPayment"/>
                                <TextBlock Text="Талон" Style="{StaticResource EditorLabelStyle}"/><TextBox x:Name="txtBoxTalon" MaxLength="24" Style="{StaticResource EditorTextBoxStyle}"/>
                                <TextBlock Text="Товары" Style="{StaticResource EditorLabelStyle}" FontWeight="SemiBold"/>
                                <ComboBox x:Name="comboOrderProduct" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <Grid Margin="0 8 0 10"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="txtBoxQuantity" Text="1" MaxLength="4" Style="{StaticResource EditorTextBoxStyle}"/><Button Grid.Column="1" Content="+ Добавить позицию" Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="10 0 0 0" Click="btnAddLine_Click"/></Grid>
                                <ItemsControl x:Name="listOrderLines"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 0 1" Padding="0 10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Total, StringFormat={}{0:N2} ₽}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 5 0 0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0} шт.}" VerticalAlignment="Center" FontSize="11"/><Button Grid.Column="2" Content="×" Style="{StaticResource LinkButtonStyle}" Padding="0" Click="btnRemoveLine_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock x:Name="txtBlockOrderTotal" FontSize="19" FontWeight="Bold" Margin="0 16 0 0"/>
                                <TextBlock x:Name="txtBlockAmountHint" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 6 0 0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0 14 0 0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Отменить" Style="{StaticResource SecondaryButtonStyle}" Click="btnCancel_Click"/><Button x:Name="btnSave" Grid.Column="2" Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Click="btnSave_Click"/></Grid>
                </Grid>
            </Border>
            <!-- #endregion -->
        </Grid>
    </Grid>
</UserControl>
