<Page x:Class="BookClubApp.Pages.NewPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="380"
      Title="Новый пароль" Background="{StaticResource WhiteBrush}"
      FontFamily="Segoe UI" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24 16 24 24">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="‹" FontSize="26" HorizontalAlignment="Left" Padding="0" Width="24"
                    ToolTip="Вернуться назад" AutomationProperties.Name="Вернуться назад"
                    Style="{StaticResource LinkButtonStyle}" Click="btnBack_Click"/>
            <StackPanel Grid.Row="1" MaxWidth="320" Margin="0 22 0 0">
                <TextBlock Text="Новый пароль" Style="{StaticResource AuthTitleStyle}"/>
                <TextBlock Text="Придумайте новый пароль&#10;для вашего аккаунта" Style="{StaticResource AuthDescriptionStyle}"/>
                <Image Source="{StaticResource PasswordImage}" Style="{StaticResource AuthIllustrationStyle}"
                       Width="110" Height="110" Margin="0 4 0 0"/>
                <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabelStyle}" Margin="0 18 0 7"/>
                <Grid>
                    <PasswordBox x:Name="pwdBoxNewPassword" Style="{StaticResource AuthPasswordBoxStyle}"
                                 AutomationProperties.Name="Новый пароль" PasswordChanged="pwdBox_PasswordChanged"/>
                    <TextBox x:Name="pwdBoxNewPasswordVisible" Style="{StaticResource AuthTextBoxStyle}"
                             Padding="38 0 38 0" Visibility="Collapsed" TextChanged="txtBoxPassword_TextChanged"
                             AutomationProperties.Name="Новый пароль"/>
                    <TextBlock x:Name="pwdBoxNewPasswordHint" Text="Введите новый пароль" Margin="39 0 36 0" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}" IsHitTestVisible="False"/>
                    <Path Data="M 2,7 L 14,7 L 14,17 L 2,17 Z M 4,7 L 4,4 C 4,-1 12,-1 12,4 L 12,7"
                          Width="16" Height="19" Margin="12 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                    <Button Tag="pwdBoxNewPassword" HorizontalAlignment="Right" Width="34" Padding="8" Focusable="True"
                            Style="{StaticResource LinkButtonStyle}" Click="btnShowPassword_Click"
                            ToolTip="Показать или скрыть пароль" AutomationProperties.Name="Показать или скрыть пароль">
                        <Path Data="M 0,5 Q 7,-4 14,5 Q 7,14 0,5 Z M 9,5 A 2,2 0 1 1 5,5 A 2,2 0 1 1 9,5"
                              Width="14" Height="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                </Grid>
                <StackPanel Margin="0 9 0 0">
                    <TextBlock Text="○  Не менее 8 символов"/>
                    <TextBlock Text="○  Есть заглавная буква"/>
                    <TextBlock Text="○  Есть цифры"/>
                    <TextBlock Text="○  Есть специальный символ (например, !@#)"/>
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Margin" Value="0 2"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </StackPanel.Resources>
                </StackPanel>
                <TextBlock Text="Повторите пароль" Style="{StaticResource FieldLabelStyle}" Margin="0 18 0 7"/>
                <Grid>
                    <PasswordBox x:Name="pwdBoxRepeatPassword" Style="{StaticResource AuthPasswordBoxStyle}"
                                 AutomationProperties.Name="Повторите пароль" PasswordChanged="pwdBox_PasswordChanged"/>
                    <TextBox x:Name="pwdBoxRepeatPasswordVisible" Style="{StaticResource AuthTextBoxStyle}"
                             Padding="38 0 38 0" Visibility="Collapsed" TextChanged="txtBoxPassword_TextChanged"
                             AutomationProperties.Name="Повторите пароль"/>
                    <TextBlock x:Name="pwdBoxRepeatPasswordHint" Text="Введите пароль ещё раз" Margin="39 0 36 0" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}" IsHitTestVisible="False"/>
                    <Path Data="M 2,7 L 14,7 L 14,17 L 2,17 Z M 4,7 L 4,4 C 4,-1 12,-1 12,4 L 12,7"
                          Width="16" Height="19" Margin="12 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                    <Button Tag="pwdBoxRepeatPassword" HorizontalAlignment="Right" Width="34" Padding="8" Focusable="True"
                            Style="{StaticResource LinkButtonStyle}" Click="btnShowPassword_Click"
                            ToolTip="Показать или скрыть пароль" AutomationProperties.Name="Показать или скрыть пароль">
                        <Path Data="M 0,5 Q 7,-4 14,5 Q 7,14 0,5 Z M 9,5 A 2,2 0 1 1 5,5 A 2,2 0 1 1 9,5"
                              Width="14" Height="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                </Grid>
                <Button Content="Сохранить" Style="{StaticResource ArrowButtonStyle}" Margin="0 24 0 0" Click="btnSave_Click"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
