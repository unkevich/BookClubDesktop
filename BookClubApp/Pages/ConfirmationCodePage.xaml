<Page x:Class="BookClubApp.Pages.ConfirmationCodePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="380"
      Title="Код подтверждения" Background="{StaticResource WhiteBrush}"
      FontFamily="Segoe UI" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24 16 24 24">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="‹" FontSize="26" HorizontalAlignment="Left" Padding="0" Width="24"
                    ToolTip="Вернуться назад" AutomationProperties.Name="Вернуться назад"
                    Style="{StaticResource LinkButtonStyle}" Click="btnBack_Click"/>
            <StackPanel Grid.Row="1" MaxWidth="320" Margin="0 22 0 0">
                <TextBlock Text="Код подтверждения" Style="{StaticResource AuthTitleStyle}"/>
                <TextBlock Text="Мы отправили код на номер" Style="{StaticResource AuthDescriptionStyle}"/>
                <TextBlock x:Name="txtBlockPhone" Text="+7 900 123-45-67" Style="{StaticResource AuthDescriptionStyle}"/>
                <Image Source="{StaticResource CodeImage}" Style="{StaticResource AuthIllustrationStyle}"
                       Width="120" Height="120" Margin="0 18 0 18"/>
                <TextBlock Text="Введите 6-значный код" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                <UniformGrid Columns="6" Margin="-3 0">
                    <TextBox x:Name="txtBoxCode1" Style="{StaticResource CodeTextBoxStyle}" Margin="3 0"
                             AutomationProperties.Name="Цифра кода 1" PreviewTextInput="txtBoxCode_PreviewTextInput"
                             TextChanged="txtBoxCode_TextChanged" PreviewKeyDown="txtBoxCode_PreviewKeyDown"
                             DataObject.Pasting="txtBoxCode_Pasting"/>
                    <TextBox x:Name="txtBoxCode2" Style="{StaticResource CodeTextBoxStyle}" Margin="3 0"
                             AutomationProperties.Name="Цифра кода 2" PreviewTextInput="txtBoxCode_PreviewTextInput"
                             TextChanged="txtBoxCode_TextChanged" PreviewKeyDown="txtBoxCode_PreviewKeyDown"
                             DataObject.Pasting="txtBoxCode_Pasting"/>
                    <TextBox x:Name="txtBoxCode3" Style="{StaticResource CodeTextBoxStyle}" Margin="3 0"
                             AutomationProperties.Name="Цифра кода 3" PreviewTextInput="txtBoxCode_PreviewTextInput"
                             TextChanged="txtBoxCode_TextChanged" PreviewKeyDown="txtBoxCode_PreviewKeyDown"
                             DataObject.Pasting="txtBoxCode_Pasting"/>
                    <TextBox x:Name="txtBoxCode4" Style="{StaticResource CodeTextBoxStyle}" Margin="3 0"
                             AutomationProperties.Name="Цифра кода 4" PreviewTextInput="txtBoxCode_PreviewTextInput"
                             TextChanged="txtBoxCode_TextChanged" PreviewKeyDown="txtBoxCode_PreviewKeyDown"
                             DataObject.Pasting="txtBoxCode_Pasting"/>
                    <TextBox x:Name="txtBoxCode5" Style="{StaticResource CodeTextBoxStyle}" Margin="3 0"
                             AutomationProperties.Name="Цифра кода 5" PreviewTextInput="txtBoxCode_PreviewTextInput"
                             TextChanged="txtBoxCode_TextChanged" PreviewKeyDown="txtBoxCode_PreviewKeyDown"
                             DataObject.Pasting="txtBoxCode_Pasting"/>
                    <TextBox x:Name="txtBoxCode6" Style="{StaticResource CodeTextBoxStyle}" Margin="3 0"
                             AutomationProperties.Name="Цифра кода 6" PreviewTextInput="txtBoxCode_PreviewTextInput"
                             TextChanged="txtBoxCode_TextChanged" PreviewKeyDown="txtBoxCode_PreviewKeyDown"
                             DataObject.Pasting="txtBoxCode_Pasting"/>
                </UniformGrid>
                <TextBlock x:Name="txtBlockResend" Text="Отправить код повторно можно через 00:52" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0 16 0 0"/>
                <Button Content="Продолжить" Style="{StaticResource ArrowButtonStyle}" Margin="0 24 0 0" Click="btnContinue_Click"/>
                <Button x:Name="btnResend" IsEnabled="False" Content="Отправить новый код" Style="{StaticResource LinkButtonStyle}" Margin="0 8 0 0" Click="btnResend_Click"/>
                <Button Content="Вернуться назад" Style="{StaticResource LinkButtonStyle}" Margin="0 4 0 0" Click="btnBack_Click"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
