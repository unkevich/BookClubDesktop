<Page x:Class="BookClubApp.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная" FontFamily="Segoe UI" FontSize="13" Language="ru-RU"
      Foreground="{StaticResource TextMainBrush}" Background="{StaticResource WhiteBrush}"
      Loaded="Page_Loaded" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- #region Header -->
        <Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 0 1" Padding="24 16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/bookclub_logo.png" Width="56" Height="56"/>
                    <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="Книжный клуб" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Книги и канцелярские товары" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 5 0 0"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Margin="16 0 24 0" VerticalAlignment="Center">
                    <TextBox x:Name="txtBoxSearch" Style="{StaticResource AuthTextBoxStyle}" Height="44" TextChanged="txtBoxSearch_TextChanged" AutomationProperties.Name="Поиск заказов, товаров, клиентов"/>
                    <Path Data="{StaticResource SearchIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" HorizontalAlignment="Left" Margin="12 0 0 0" IsHitTestVisible="False"/>
                    <TextBlock Text="Поиск заказов, товаров, клиентов..." Foreground="{StaticResource TextSecondaryBrush}" Margin="39 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtBoxSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="56" Click="btnProfile_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Профиль пользователя">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource DividersBrush}" CornerRadius="22" Width="36" Height="36">
                            <Path Data="M 10,3 A 4,4 0 1 1 10,11 A 4,4 0 1 1 10,3 Z M 2,23 C 2,12 18,12 18,23 Z" Width="20" Height="24" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.4"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6 0 0 0"><TextBlock x:Name="txtBlockUser" FontWeight="SemiBold"/><TextBlock x:Name="txtBlockRole" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 0"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>
        <!-- #endregion -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 1 0">
                <DockPanel Margin="0 14 0 18">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButtonStyle}" HorizontalContentAlignment="Left" Margin="20 0" Click="btnLogout_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ExitIcon}" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.4"/><TextBlock Text="Выйти" Margin="16 0 0 0" VerticalAlignment="Center" Foreground="{StaticResource TextMainBrush}"/></StackPanel>
                    </Button>
                    <ListBox x:Name="listMenu" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource MenuItemStyle}" SelectionChanged="listMenu_SelectionChanged">
                        <ListBoxItem Content="Главная" Tag="{StaticResource HomeIcon}"/>
                        <ListBoxItem Content="Заказы" Tag="{StaticResource OrderIcon}"/>
                        <ListBoxItem Content="Товары" Tag="{StaticResource ProductIcon}"/>
                        <ListBoxItem Content="Клиенты" Tag="{StaticResource UsersIcon}"/>
                    </ListBox>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource BackgroundListBrush}">
                <StackPanel Margin="22">
                    <Grid Margin="0 0 0 16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtBlockSection" Text="Главная" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                        <Button x:Name="btnRefresh" Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryButtonStyle}" Height="34" Click="btnRefresh_Click"/>
                    </Grid>
                    <Border x:Name="statusPanel" Visibility="Collapsed" Background="{StaticResource BackgroundInfoBrush}" CornerRadius="6" Padding="14" Margin="0 0 0 16">
                        <TextBlock x:Name="txtBlockStatus" TextWrapping="Wrap"/>
                    </Border>
                    <!-- #region Dashboard -->
                    <StackPanel x:Name="panelHome">
                        <UniformGrid Columns="4" Margin="-6 0 -6 18">
                            <Border Style="{StaticResource PanelStyle}" Margin="6 0" Padding="15"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource OrderIcon}" Width="26" Height="30" Stretch="Uniform" Stroke="{StaticResource MainBrush}" StrokeThickness="1.4" Margin="0 0 14 0"/><StackPanel><TextBlock x:Name="txtBlockOrderCount" Text="—" FontSize="25" FontWeight="Bold"/><TextBlock Text="Заказов" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 5 0 0"/></StackPanel></StackPanel></Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="6 0" Padding="15"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ProductIcon}" Width="28" Height="30" Stretch="Uniform" Stroke="{StaticResource MainBrush}" StrokeThickness="1.4" Margin="0 0 14 0"/><StackPanel><TextBlock x:Name="txtBlockProductCount" Text="—" FontSize="25" FontWeight="Bold"/><TextBlock Text="Товаров" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 5 0 0"/></StackPanel></StackPanel></Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="6 0" Padding="15"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource UsersIcon}" Width="30" Height="30" Stretch="Uniform" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.4" Margin="0 0 14 0"/><StackPanel><TextBlock x:Name="txtBlockClientCount" Text="—" FontSize="25" FontWeight="Bold"/><TextBlock Text="Клиентов" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 5 0 0"/></StackPanel></StackPanel></Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="6 0" Padding="15"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource StockIcon}" Width="28" Height="28" Stretch="Uniform" Stroke="{StaticResource WarnBrush}" StrokeThickness="1.4" Margin="0 0 14 0"/><StackPanel><TextBlock x:Name="txtBlockLowStockCount" Text="—" FontSize="25" FontWeight="Bold"/><TextBlock Text="Мало на складе" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 5 0 0"/></StackPanel></StackPanel></Border>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource PanelStyle}" Padding="0" Margin="0 0 18 18">
                                    <StackPanel>
                                        <DockPanel Margin="18"><Button DockPanel.Dock="Right" Content="Все заказы  ›" Style="{StaticResource LinkButtonStyle}" Padding="0" Foreground="{StaticResource InfoBrush}" Click="btnOrders_Click"/><TextBlock Text="Последние заказы" Style="{StaticResource SectionTitleStyle}" FontSize="18"/></DockPanel>
                                        <DataGrid x:Name="gridRecentOrders" Style="{StaticResource DashboardGridStyle}" MouseDoubleClick="gridOrders_MouseDoubleClick" Height="260">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="№ заказа" Binding="{Binding Number}" Width="76"/>
                                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90"/>
                                                <DataGridTextColumn Header="Клиент" Binding="{Binding Phone}" Width="125"/>
                                                <DataGridTextColumn Header="Состав" Binding="{Binding ItemCount}" Width="65"/>
                                                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="95"/>
                                                <DataGridTemplateColumn Header="Статус" CellTemplate="{StaticResource OrderStatusTemplate}" Width="*" MinWidth="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="txtBlockNoOrders" Text="Заказов пока нет" Visibility="Collapsed" Margin="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}" Margin="0 0 18 0" Padding="18">
                                    <StackPanel>
                                        <DockPanel Margin="0 0 0 18"><Button DockPanel.Dock="Right" Content="Все товары  ›" Style="{StaticResource LinkButtonStyle}" Padding="0" Foreground="{StaticResource InfoBrush}" Click="btnProducts_Click"/><TextBlock Text="Популярные товары" Style="{StaticResource SectionTitleStyle}" FontSize="18"/></DockPanel>
                                        <ItemsControl x:Name="listPopularProducts" ItemTemplate="{StaticResource ProductCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                        <TextBlock x:Name="txtBlockNoProducts" Text="Товаров пока нет" Visibility="Collapsed" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource PanelStyle}" Padding="18" Margin="0 0 0 18">
                                    <StackPanel><TextBlock Text="Быстрые действия" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0 0 0 16"/>
                                        <UniformGrid Columns="2" Margin="-4">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Height="90" Margin="4" Padding="4" Click="btnOrders_Click">
                                                <StackPanel><Path Data="{StaticResource OrderIcon}" Width="22" Height="24" Stretch="Uniform" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.4"/><TextBlock Text="Заказы" FontSize="12" FontWeight="Normal" TextAlignment="Center" Margin="0 10 0 0"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Height="90" Margin="4" Padding="4" Click="btnProducts_Click">
                                                <StackPanel><Path Data="{StaticResource ProductIcon}" Width="23" Height="24" Stretch="Uniform" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.4"/><TextBlock Text="Товары" FontSize="12" FontWeight="Normal" TextAlignment="Center" Margin="0 10 0 0"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Height="90" Margin="4" Padding="4" Click="btnClients_Click">
                                                <StackPanel><Path Data="{StaticResource UsersIcon}" Width="25" Height="24" Stretch="Uniform" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.4"/><TextBlock Text="Клиенты" FontSize="12" FontWeight="Normal" TextAlignment="Center" Margin="0 10 0 0"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Height="90" Margin="4" Padding="4" Click="btnRefresh_Click">
                                                <StackPanel><Path Data="M 19,6 A 9,9 0 1 0 19,16 M 13,6 L 20,6 20,0" Width="23" Height="24" Stretch="Uniform" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.4"/><TextBlock Text="Обновить" FontSize="12" FontWeight="Normal" TextAlignment="Center" Margin="0 10 0 0"/></StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}" Padding="18"><StackPanel>
                                    <TextBlock Text="Требуют внимания" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0 0 0 8"/>
                                    <TextBlock Text="Остаток достиг минимального значения" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0 0 0 16"/>
                                    <ItemsControl x:Name="listLowStock"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 0 1" Padding="0 10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StockText}" Foreground="{Binding StockBrush}" Margin="0 6 0 0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <TextBlock x:Name="txtBlockStockOk" Text="Недостатка товаров нет" Visibility="Collapsed" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <!-- #endregion -->
                    <Border x:Name="panelOrders" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                        <StackPanel><TextBlock Text="Дважды нажмите на заказ, чтобы посмотреть его состав." Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 14"/>
                            <DataGrid x:Name="gridOrders" Style="{StaticResource DashboardGridStyle}" Height="520" MouseDoubleClick="gridOrders_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№ заказа" Binding="{Binding Number}" Width="85"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="105"/>
                                    <DataGridTextColumn Header="Телефон клиента" Binding="{Binding Phone}" Width="145"/>
                                    <DataGridTextColumn Header="Позиций" Binding="{Binding ItemCount}" Width="80"/>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="110"/>
                                    <DataGridTemplateColumn Header="Статус" CellTemplate="{StaticResource OrderStatusTemplate}" Width="*" MinWidth="110"/>
                                    <DataGridTextColumn Header="Оплата" Binding="{Binding Payment}" Width="110"/>
                                    <DataGridTextColumn Header="Талон" Binding="{Binding Talon}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="panelProducts" Style="{StaticResource PanelStyle}" Visibility="Collapsed"><ItemsControl x:Name="listProducts" ItemTemplate="{StaticResource ProductCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Border>
                    <Border x:Name="panelClients" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                        <DataGrid x:Name="gridClients" Style="{StaticResource DashboardGridStyle}" Height="520"><DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                            <DataGridTextColumn Header="Номер телефона" Binding="{Binding NumberPhone}" Width="*"/>
                            <DataGridTextColumn Header="Дата регистрации" Binding="{Binding Created_at, StringFormat=dd.MM.yyyy}" Width="180"/>
                            <DataGridTextColumn Header="Заказов" Binding="{Binding OrderCount}" Width="110"/>
                        </DataGrid.Columns></DataGrid>
                    </Border>
                    <TextBlock x:Name="txtBlockEmpty" Text="Ничего не найдено" Visibility="Collapsed" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 18"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
