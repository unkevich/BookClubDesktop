<Page x:Class="BookClubApp.Pages.ProductsTablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книжный клуб" FontFamily="Segoe UI" Language="ru-RU" FontSize="13"
      Foreground="{StaticResource TextMainBrush}" Background="{StaticResource BackgroundListBrush}"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/><ColumnDefinition Width="335"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="3" Background="White" BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 0 1" Padding="24 15">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Resources/Images/bookclub_logo.png" Width="55" Height="55"/><StackPanel Margin="12 0" VerticalAlignment="Center"><TextBlock Text="Книжный клуб" FontSize="22" FontWeight="Bold"/><TextBlock Text="Книги и канцелярские товары" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 5 0 0"/></StackPanel></StackPanel>
                <Grid Grid.Column="1" Margin="12 5 22 5"><TextBox x:Name="txtBoxSearch" Style="{StaticResource AuthTextBoxStyle}" Height="44" TextChanged="txtBoxSearch_TextChanged" AutomationProperties.Name="Поиск книг и товаров"/><Path Data="{StaticResource SearchIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3" HorizontalAlignment="Left" Margin="12 0 0 0" IsHitTestVisible="False"/><TextBlock Text="Поиск книг, товаров..." Foreground="{StaticResource TextSecondaryBrush}" Margin="39 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtBoxSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                <ComboBox x:Name="comboPickup" Grid.Column="2" Height="44" VerticalAlignment="Center" ToolTip="г. Таганрог, ул. Чехова, 336"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Address}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 1 0">
            <DockPanel Margin="0 18 0 20"><StackPanel DockPanel.Dock="Bottom" Margin="18"><TextBlock x:Name="txtBlockAccount" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0 0 0 10"/><Button x:Name="btnLogout" Content="Выйти" Style="{StaticResource SecondaryButtonStyle}" Click="btnLogout_Click"/></StackPanel>
                <StackPanel><ListBox x:Name="listCategories" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource MenuItemStyle}" SelectionChanged="listCategories_SelectionChanged"/><Button x:Name="btnMyOrders" Content="Мои заказы" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Padding="28 18" Click="btnMyOrders_Click"/></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" Margin="22 20 12 20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelStyle}" Padding="20 16" Margin="0 0 0 16"><Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="txtBlockTitle" Text="Все товары" Style="{StaticResource SectionTitleStyle}" FontSize="25"/><TextBlock x:Name="txtBlockCount" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 6 0 0"/></StackPanel><ComboBox x:Name="comboSort" Grid.Column="1" SelectionChanged="comboSort_SelectionChanged" VerticalAlignment="Center"/></Grid></Border>
            <Border x:Name="statusPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource BackgroundInfoBrush}" Padding="12" CornerRadius="6" Margin="0 0 0 12"><TextBlock x:Name="txtBlockStatus" TextWrapping="Wrap"/></Border>
            <ScrollViewer x:Name="catalogueScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="listProducts"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource PanelStyle}" Padding="14" Margin="0 0 5 10"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Grid Width="68" Height="95" HorizontalAlignment="Left"><Border Background="{StaticResource BackgroundListBrush}" CornerRadius="4"/><Path Data="{StaticResource ProductIcon}" Width="30" Height="32" Stretch="Uniform" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/><Image Source="{Binding Cover}" Stretch="Uniform"/></Grid>
                        <StackPanel Grid.Column="1" Margin="0 0 12 0"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding Author}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 6 0 0"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0 7 0 0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding OldPriceLabel}" TextDecorations="Strikethrough" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 6 0 0"/><TextBlock Text="{Binding StockText}" Foreground="{Binding StockBrush}" FontSize="11" TextWrapping="Wrap" Margin="0 8 0 0"/><TextBlock Text="{Binding DiscountText}" Foreground="{StaticResource MainBrush}" FontSize="12" Margin="0 5 0 0"/></StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource MoreButtonStyle}" VerticalAlignment="Center" Click="btnProductMenu_Click"/>
                    </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="checkoutScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0 0 5 0">
                <Border Style="{StaticResource PanelStyle}" Margin="0 0 0 12"><StackPanel><TextBlock Text="1   Состав заказа" Style="{StaticResource SectionTitleStyle}" FontSize="18"/><TextBlock Text="Количество товаров можно изменить в корзине справа." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 10 0 14"/><ItemsControl x:Name="listCheckout"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 0 1" Padding="0 12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Product.Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Quantity, StringFormat={}{0} шт.}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 6 0 0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:N2} ₽}" FontWeight="Bold" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Style="{StaticResource PanelStyle}" Margin="0 0 0 12"><StackPanel><TextBlock Text="2   Пункт выдачи №1" Style="{StaticResource SectionTitleStyle}" FontSize="18"/><TextBlock Text="г. Таганрог, ул. Чехова, 336" FontSize="15" TextWrapping="Wrap" Margin="0 14 0 6"/><TextBlock Text="Самовывоз. Для получения понадобится талон заказа." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource PanelStyle}"><StackPanel><TextBlock Text="3   Оплата" Style="{StaticResource SectionTitleStyle}" FontSize="18"/><TextBlock Text="Оплата наличными при получении в пункте выдачи. После оформления товары будут зарезервированы, а чек и талон можно сохранить в PDF." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 12 0 0"/></StackPanel></Border>
                <Button Content="‹ Назад к товарам" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0 12 0 0" Click="btnBackToProducts_Click"/>
            </StackPanel></ScrollViewer>
            <Border x:Name="myOrdersPanel" Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="16" Visibility="Collapsed"><DataGrid x:Name="gridMyOrders" FrozenColumnCount="2" Style="{StaticResource DashboardGridStyle}"><DataGrid.Columns>
                <DataGridTextColumn Header="Заказ" Binding="{Binding Number}" Width="70"/><DataGridTemplateColumn Header="Документ" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="PDF" Height="30" Width="58" Padding="6 0" Style="{StaticResource SecondaryButtonStyle}" Click="btnReceipt_Click" ToolTip="Сохранить чек и талон в PDF"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="95"/><DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="100"/><DataGridTemplateColumn Header="Статус" CellTemplate="{StaticResource OrderStatusTemplate}" Width="135"/><DataGridTextColumn Header="Оплата" Binding="{Binding Payment}" Width="180" MinWidth="180"/><DataGridTextColumn Header="Талон" Binding="{Binding Talon}" Width="*" MinWidth="190"/>
            </DataGrid.Columns></DataGrid></Border>
        </Grid>
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="8 20 18 20" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Текущий заказ" Style="{StaticResource SectionTitleStyle}" FontSize="19"/><Button Grid.Column="1" Content="Очистить" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource MainBrush}" Padding="4 0" Click="btnClearCart_Click"/></Grid><TextBlock x:Name="txtBlockCartCount" Text="Товаров: 0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 8 0 14"/></StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="listCart"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 0 0 1" Padding="0 12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="38" Height="55" VerticalAlignment="Top"><Border Background="{StaticResource BackgroundListBrush}"/><Image Source="{Binding Product.Cover}" Stretch="Uniform"/></Grid><StackPanel Grid.Column="1"><TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Total, StringFormat={}{0:N2} ₽}" FontWeight="Bold" Margin="0 6 0 0"/><StackPanel Orientation="Horizontal" Margin="0 10 0 0"><Button Content="−" Width="29" Height="28" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="btnDecrease_Click"/><TextBlock Text="{Binding Quantity}" Width="34" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Width="29" Height="28" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="btnIncrease_Click"/><Button Content="×" Width="28" Height="28" Padding="0" Margin="12 0 0 0" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource MainBrush}" Click="btnRemoveCart_Click"/></StackPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0 14 0 0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Товары" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="txtBlockOriginal" Grid.Column="1" FontWeight="SemiBold"/></Grid><Grid Margin="0 10 0 16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Скидка" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="txtBlockDiscount" Grid.Column="1" Foreground="{StaticResource MainBrush}"/></Grid><Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="0 1 0 0" Padding="0 15 0 0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Итого" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="txtBlockTotal" Grid.Column="1" FontSize="22" FontWeight="Bold"/></Grid></Border><Button x:Name="btnCheckout" Content="Перейти к оформлению" Style="{StaticResource PrimaryButtonStyle}" Height="48" FontSize="13" Margin="0 20 0 12" Click="btnCheckout_Click"/><TextBlock Text="Пункт выдачи №1&#10;г. Таганрог, ул. Чехова, 336" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/><TextBlock x:Name="txtBlockGuestHint" Text="Для покупок войдите в аккаунт клиента." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 12 0 0" FontSize="12" Visibility="Collapsed"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
