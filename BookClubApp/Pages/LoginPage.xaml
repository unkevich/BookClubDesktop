<Page x:Class="BookClubApp.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход в аккаунт" Background="{StaticResource WhiteBrush}" FontFamily="Segoe UI" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24 22" MaxWidth="320">
            <Grid Margin="0 0 0 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Resources/Images/bookclub_logo.png" Width="55" Height="55"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10 0 0 0">
                    <TextBlock Text="Книжный клуб" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="Книги и канцелярские товары" FontSize="10" Margin="0 4 0 0" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <Border BorderBrush="{StaticResource DividersBrush}" BorderThickness="1" CornerRadius="8" Padding="18 20">
                <StackPanel>
                    <TextBlock Text="Вход в аккаунт" Style="{StaticResource AuthTitleStyle}" TextAlignment="Left"/>
                    <TextBlock Text="Войдите, чтобы продолжить работу&#10;в Книжном клубе" Style="{StaticResource AuthDescriptionStyle}" TextAlignment="Left" Margin="0 0 0 22"/>
                <TextBlock Text="Номер телефона" Style="{StaticResource FieldLabelStyle}"/>
                <Grid>
                    <TextBox x:Name="txtBoxPhone" Style="{StaticResource PhoneTextBoxStyle}"
                             AutomationProperties.Name="Номер телефона: +7 и десять цифр"/>
                    <TextBlock Text="+7" Margin="39 0 0 0" VerticalAlignment="Center" Foreground="{StaticResource TextMainBrush}" IsHitTestVisible="False"/>
                    <TextBlock Text="(___) ___-__-__" Margin="65 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDisabledBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtBoxPhone}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Data="M 3,1 L 11,1 L 11,17 L 3,17 Z M 6,14 L 8,14" Width="12" Height="18"
                          Margin="13 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.3" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock Text="Пароль" Style="{StaticResource FieldLabelStyle}" Margin="0 18 0 7"/>
                <Grid>
                    <PasswordBox x:Name="pwdBoxPassword" Style="{StaticResource AuthPasswordBoxStyle}"
                                 AutomationProperties.Name="Пароль" PasswordChanged="pwdBox_PasswordChanged"/>
                    <TextBox x:Name="pwdBoxPasswordVisible" Style="{StaticResource AuthTextBoxStyle}"
                             Padding="38 0 38 0" Visibility="Collapsed" TextChanged="txtBoxPassword_TextChanged"
                             AutomationProperties.Name="Пароль"/>
                    <TextBlock x:Name="pwdBoxPasswordHint" Text="Введите пароль" Margin="39 0 36 0" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}" IsHitTestVisible="False"/>
                    <Path Data="M 2,7 L 14,7 L 14,17 L 2,17 Z M 4,7 L 4,4 C 4,-1 12,-1 12,4 L 12,7"
                          Width="16" Height="19" Margin="12 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                    <Button Tag="pwdBoxPassword" HorizontalAlignment="Right" Width="34" Padding="8" Focusable="True"
                            Style="{StaticResource LinkButtonStyle}" Click="btnShowPassword_Click"
                            ToolTip="Показать или скрыть пароль" AutomationProperties.Name="Показать или скрыть пароль">
                        <Path Data="M 0,5 Q 7,-4 14,5 Q 7,14 0,5 Z M 9,5 A 2,2 0 1 1 5,5 A 2,2 0 1 1 9,5"
                              Width="14" Height="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                </Grid>

                    <Grid Margin="0 16 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkBoxRemember" Content="Запомнить номер" IsChecked="False" VerticalAlignment="Center" Style="{StaticResource AuthCheckBoxStyle}"/>
                        <Button Grid.Column="1" Content="Забыли пароль?" FontSize="11" Foreground="{StaticResource MainBrush}" Padding="0 8" Style="{StaticResource LinkButtonStyle}" Click="btnForgotPassword_Click"/>
                    </Grid>
                <TextBlock x:Name="txtBlockLoginError" Visibility="Collapsed" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="0 8 0 0"/>
                <Button x:Name="btnLogin" IsDefault="True" Content="Войти" Style="{StaticResource ArrowButtonStyle}" Margin="0 14 0 0" Click="btnLogin_Click"/>

                    <Grid Margin="0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="1" Background="{StaticResource DividersBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="или" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource DividersBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="btnLoginGuest" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Stretch" FontWeight="Normal" Click="btnLoginGuest_Click" AutomationProperties.Name="Войти как гость">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M 8,1 A 3,3 0 1 1 8,7 A 3,3 0 1 1 8,1 Z M 2,16 C 2,8 14,8 14,16 Z" Width="16" Height="18" VerticalAlignment="Center" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.2"/>
                            <TextBlock Grid.Column="1" Text="Войти как гость" FontSize="12" VerticalAlignment="Center" Margin="8 0 0 0"/>
                            <Path Grid.Column="2" Data="M 1,1 L 5,5 L 1,9" Width="6" Height="10" VerticalAlignment="Center" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.2"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
