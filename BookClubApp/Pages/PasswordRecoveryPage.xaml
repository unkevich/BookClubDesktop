<Page x:Class="BookClubApp.Pages.PasswordRecoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="380"
      Title="Восстановление пароля" Background="{StaticResource WhiteBrush}"
      FontFamily="Segoe UI" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24 16 24 24">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="‹" FontSize="26" HorizontalAlignment="Left" Padding="0" Width="24"
                    ToolTip="Вернуться назад" AutomationProperties.Name="Вернуться назад"
                    Style="{StaticResource LinkButtonStyle}" Click="btnBack_Click"/>
            <StackPanel Grid.Row="1" MaxWidth="320" Margin="0 22 0 0">
                <TextBlock Text="Восстановление пароля" Style="{StaticResource AuthTitleStyle}"/>
                <TextBlock Text="Введите номер телефона,&#10;указанный в вашем аккаунте" Style="{StaticResource AuthDescriptionStyle}"/>
                <Image Source="{StaticResource PhoneMessageImage}" Style="{StaticResource AuthIllustrationStyle}"/>
                <TextBlock Text="Номер телефона" Style="{StaticResource FieldLabelStyle}"/>
                <Grid>
                    <TextBox x:Name="txtBoxPhone" Style="{StaticResource PhoneTextBoxStyle}"
                             AutomationProperties.Name="Номер телефона: 8 и десять цифр"/>
                    <TextBlock Text="8" Margin="39 0 0 0" VerticalAlignment="Center" Foreground="{StaticResource TextMainBrush}" IsHitTestVisible="False"/>
                    <TextBlock Text="(___) ___-__-__" Margin="55 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDisabledBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtBoxPhone}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Data="M 3,1 L 11,1 L 11,17 L 3,17 Z M 6,14 L 8,14" Width="12" Height="18"
                          Margin="13 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.3" IsHitTestVisible="False"/>
                </Grid>
                <Button Content="Продолжить" Style="{StaticResource ArrowButtonStyle}" Margin="0 24 0 0" Click="btnContinue_Click"/>
                <Button Content="Вернуться к входу" Style="{StaticResource LinkButtonStyle}" Margin="0 14 0 0" Click="btnLogin_Click"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
