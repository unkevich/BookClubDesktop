<Window x:Class="BookClubApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Книжный клуб"
        Height="660" Width="400" MinHeight="600" MinWidth="380"
        Icon="/Resources/Images/bookclub_logo.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundListBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Border Margin="10" CornerRadius="8" Background="{StaticResource WhiteBrush}"
            BorderBrush="{StaticResource DividersBrush}" BorderThickness="1">
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
    </Border>
</Window>
