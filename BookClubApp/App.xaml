<Application x:Class="BookClubApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BookClubApp"
             StartupUri="AuthWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ColorStyles.xaml"/>
                <ResourceDictionary Source="/Styles/AuthIllustrations.xaml"/>
                <ResourceDictionary Source="/Styles/AuthStyles.xaml"/>
                <ResourceDictionary Source="/Styles/DashboardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
