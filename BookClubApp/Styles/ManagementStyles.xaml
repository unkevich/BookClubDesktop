<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общие выпадающие списки и меню для всех разделов. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12 10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="itemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="3 1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                    <ContentPresenter/><TextBlock x:Name="selectedMark" Grid.Column="1" Text="✓" Foreground="{StaticResource MainBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BackgroundListBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter TargetName="selectedMark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/><Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="dropButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="6">
                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource TextMainBrush}" StrokeThickness="1.3" Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 13 0"/>
                        </Border>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Margin="12 0 32 0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource DividersBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="4 3 8 10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.12" Color="#0F172A"/></Border.Effect>
                        <ScrollViewer MaxHeight="300" CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource MainBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/><Setter Property="FontSize" Value="12"/>
        <Setter Property="Tag" Value="Дата"/>
        <Setter Property="CalendarStyle"><Setter.Value><Style TargetType="Calendar"><Setter Property="Background" Value="{StaticResource WhiteBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
            <Border Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0" Padding="10 0" Margin="0 0 30 0" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="dateHint" Text="{TemplateBinding Tag}" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextSecondaryBrush}" Margin="10 0 30 0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Button x:Name="PART_Button" Width="30" HorizontalAlignment="Right" Focusable="False" Style="{StaticResource LinkButtonStyle}" Padding="7" AutomationProperties.Name="Открыть календарь">
                        <Path Data="M 1,4 L 15,4 15,17 1,17 Z M 1,8 L 15,8 M 4,1 L 4,6 M 12,1 L 12,6" Width="15" Height="18" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2"/>
                    </Button>
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="SelectedDate" Value="{x:Null}"><Setter TargetName="dateHint" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource DividersBrush}" BorderThickness="1" CornerRadius="9" Padding="5" Margin="8" MinWidth="210">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/></Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/><Setter Property="Padding" Value="10 10"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Grid>
                <Border x:Name="menuBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Icon" Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock x:Name="checkMark" Grid.Column="2" Text="✓" Visibility="Collapsed" Foreground="{StaticResource MainBrush}" HorizontalAlignment="Right"/>
                        <Path x:Name="submenuArrow" Grid.Column="2" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" Width="5" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource DividersBrush}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="8" MinWidth="205">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/></Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="True"><Setter TargetName="submenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="menuBorder" Property="Background" Value="{StaticResource BackgroundBrush}"/></Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="menuBorder" Property="Background" Value="{StaticResource BackgroundBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="checkMark" Property="Visibility" Value="Visible"/><Setter TargetName="menuBorder" Property="Background" Value="{StaticResource BackgroundBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuSeparatorStyle" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource DividersBrush}" Margin="9 5"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Separator" BasedOn="{StaticResource MenuSeparatorStyle}"/>
    <Style x:Key="EditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AuthTextBoxStyle}"><Setter Property="Padding" Value="10 0"/><Setter Property="Background" Value="{StaticResource WhiteBrush}"/></Style>
    <Style x:Key="EditorLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}"><Setter Property="Margin" Value="0 15 0 7"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/></Style>
    <Style x:Key="MoreButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Content" Value="⋮"/><Setter Property="FontSize" Value="21"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="AutomationProperties.Name" Value="Действия"/></Style>
    <DataTemplate x:Key="ManagedProductTemplate">
        <Border Style="{StaticResource PanelStyle}" Width="164" Margin="0 0 12 12" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="43"/><RowDefinition Height="22"/><RowDefinition Height="27"/><RowDefinition Height="36"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                <Button Background="Transparent" BorderThickness="0" Padding="0" Command="{Binding OpenProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <Grid Width="136" Height="110"><Border Background="{StaticResource BackgroundListBrush}" CornerRadius="5"/><Path Data="{StaticResource ProductIcon}" Width="34" Height="40" Stretch="Uniform" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/><Image Source="{Binding Cover}" Stretch="Uniform"/></Grid>
                </Button>
                <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0 8 0 0"/>
                <TextBlock Grid.Row="2" Text="{Binding Author}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Row="3" Background="{StaticResource DividersBrush}" CornerRadius="4" Padding="6 3" HorizontalAlignment="Left"><TextBlock Text="{Binding Category}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="132"/></Border>
                <TextBlock Grid.Row="4" Text="{Binding Price, StringFormat={}{0:N2} ₽}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Row="4" HorizontalAlignment="Right" Style="{StaticResource MoreButtonStyle}" Command="{Binding ProductMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                <TextBlock Grid.Row="5" Text="{Binding StockText}" Foreground="{Binding StockBrush}" FontSize="11"/>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
