<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- #region Colors -->
    <Color x:Key="Main">#FF1F3D</Color>
    <Color x:Key="MainHover">#E00025</Color>
    <Color x:Key="MainActive">#B5001F</Color>
    <Color x:Key="LightAccent">#FFE8EB</Color>
    <Color x:Key="Background">#FFF5F6</Color>
    <Color x:Key="WhiteClr">#FFFFFF</Color>
    <Color x:Key="BackgroundList">#F8F9FB</Color>
    <Color x:Key="Dividers">#EEF0F4</Color>
    <Color x:Key="TextMain">#0F172A</Color>
    <Color x:Key="Text">#334155</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextDisabled">#94A3B8</Color>
    <Color x:Key="Border">#CBD5E1</Color>
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="BackgroundSuccess">#DCFCE7</Color>
    <Color x:Key="Warn">#FACC15</Color>
    <Color x:Key="BackgroundWarn">#FEF9C3</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="BackgroundError">#FEE2E2</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="BackgroundInfo">#DBEAFE</Color>
    <Color x:Key="BackgroundDisabled">#F1F5F9</Color>
    <Color x:Key="ToggleDisabled">#E2E8F0</Color>
    <!-- #endregion -->

    <!-- #region Brushes -->
    <SolidColorBrush x:Key="MainBrush" Color="{StaticResource Main}"/>
    <SolidColorBrush x:Key="MainHoverBrush" Color="{StaticResource MainHover}"/>
    <SolidColorBrush x:Key="MainActiveBrush" Color="{StaticResource MainActive}"/>
    <SolidColorBrush x:Key="LightAccentBrush" Color="{StaticResource LightAccent}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteClr}"/>
    <SolidColorBrush x:Key="BackgroundListBrush" Color="{StaticResource BackgroundList}"/>
    <SolidColorBrush x:Key="DividersBrush" Color="{StaticResource Dividers}"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="BackgroundSuccessBrush" Color="{StaticResource BackgroundSuccess}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}"/>
    <SolidColorBrush x:Key="BackgroundWarnBrush" Color="{StaticResource BackgroundWarn}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="BackgroundErrorBrush" Color="{StaticResource BackgroundError}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="BackgroundInfoBrush" Color="{StaticResource BackgroundInfo}"/>
    <SolidColorBrush x:Key="BackgroundDisabledBrush" Color="{StaticResource BackgroundDisabled}"/>
    <SolidColorBrush x:Key="ToggleDisabledBrush" Color="{StaticResource ToggleDisabled}"/>
    <LinearGradientBrush x:Key="MainGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Main}" Offset="0"/>
        <GradientStop Color="{StaticResource MainHover}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Background}" Offset="0"/>
        <GradientStop Color="{StaticResource WhiteClr}" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="MainGlowEffect" Color="{StaticResource Main}" Opacity="0.25" BlurRadius="24" ShadowDepth="0"/>
    <!-- #endregion -->
</ResourceDictionary>
